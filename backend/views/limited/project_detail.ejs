<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <a class="crumb" href="/my">← My projects</a>
    <h1><%= project.name %></h1>
    <p class="muted">
      <%= project.work_type || 'No work type' %> ·
      <span class="pill"><%= project.status || 'n/a' %></span>
    </p>
  </div>
</div>

<div class="cols">
  <section class="panel">
    <h2>Add a cost</h2>
    <form method="post" action="/my/projects/<%= project.id %>/expenditures" enctype="multipart/form-data" class="stack">
      <label>Category
        <select name="category" required>
          <option value="inventory">Inventory</option>
          <option value="labour">Labour</option>
          <option value="expenditure">Expenditure</option>
        </select>
      </label>
      <label>Amount (£)
        <input type="number" step="0.01" name="amount" required>
      </label>
      <label>Description
        <input type="text" name="description" placeholder="What was it for?">
      </label>
      <label>Receipt (image or PDF)
        <input type="file" name="receipt" accept="image/*,application/pdf">
      </label>
      <button type="submit" class="btn btn-primary">Add cost</button>
    </form>
  </section>

  <section class="panel">
    <h2>My costs so far</h2>
    <p class="stat-value"><%= gbp(myTotal) %></p>
    <p class="muted">Total of your own entries on this project.</p>
  </section>
</div>

<section class="panel">
  <h2>My entries</h2>
  <% if (expenditures.length === 0) { %>
    <p class="muted">You have not added any costs to this project yet.</p>
  <% } else { %>
  <div class="table-scroll">
    <table class="data">
      <thead><tr><th>Date</th><th>Category</th><th>Description</th><th class="num">Amount</th><th>Receipt</th><th></th></tr></thead>
      <tbody>
        <% expenditures.forEach(function(e) { %>
        <tr>
          <td><%= e.created_at %></td>
          <td><span class="pill pill-<%= e.category %>"><%= e.category %></span></td>
          <td><%= e.description || '—' %></td>
          <td class="num"><%= gbp(e.amount) %></td>
          <td><% if (e.receipt_path) { %><a href="/receipts/<%= e.id %>" target="_blank" rel="noopener">View</a><% } else { %>—<% } %></td>
          <td>
            <form method="post" action="/my/expenditures/<%= e.id %>/delete" class="inline" data-confirm="Delete this entry?">
              <button class="btn btn-tiny btn-ghost">Delete</button>
            </form>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
<%- include('../partials/footer') %>
