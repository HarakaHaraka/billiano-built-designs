# Billiano Built Designs — admin backend environment variables
# Copy this file to `.env` for local development and fill in real values.
# NEVER commit a real .env — only this .example file is tracked.

# Port the server listens on. Render provides its own PORT at runtime; locally defaults to 4000.
PORT=4000

# Node environment. Set to "production" on Render so secure cookies + strict CSP switch on.
NODE_ENV=development

# Secret used to sign the session cookie. Use a long random string.
# On Render this is generated automatically (see render.yaml generateValue).
SESSION_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file lives. On Render point this INSIDE the persistent
# disk mount (e.g. /var/data/billiano.db) so data survives redeploys.
# Locally it defaults to ./data/billiano.db (the data/ dir is created at boot).
DATABASE_PATH=./data/billiano.db

# Optional: where uploaded receipts are stored. Defaults to ./uploads.
# On Render point this inside the persistent disk too (e.g. /var/data/uploads).
UPLOAD_DIR=./uploads

# --- Owner seed account (used only by `npm run seed`) ---
# The first owner login. Run the seed once after setting these, then you can log in.
OWNER_USERNAME=owner
OWNER_EMAIL=executive@billianobuiltdesigns.co.uk
OWNER_PASSWORD=choose-a-strong-owner-password
