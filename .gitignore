# Dependencies
node_modules/

# Secrets — never commit real env files
.env
*.env
!*.env.example

# Local Claude Code settings
.claude/settings.local.json

# OS / editor cruft
.DS_Store
Thumbs.db
*.log

# Build output (regenerated by the build; see frontend/.gitignore too)
frontend/public/assets/app.css

# Local SQLite data / uploads (backend has its own .gitignore too)
backend/data/
backend/uploads/*
!backend/uploads/.gitkeep
